# ONEST & Beckn Protocol Integration Configuration
# This file is a template for the environment variables for Beckn and ONEST integration.

# Integration Mode: REAL (Active Beckn protocol over HTTP) or MOCK
INTEGRATION_MODE=REAL

# ONEST Network Configuration
ONEST_ENABLED=true
ONEST_BASE_URL=http://localhost:8080/api/bpp
ONEST_SUBSCRIBER_ID=skill-verification-bap.onest.network
ONEST_SUBSCRIBER_URI=http://localhost:8080/api/beckn
ONEST_REGISTRY_URL=https://registry.onest.network

# Beckn Protocol Configuration
BECKN_DOMAIN=onest:work-opportunities
# For local multi-node testing: http://localhost:8080/api/bpp
# For external Beckn Sandbox: https://sandbox.becknprotocol.io/gateway
BECKN_GATEWAY_URL=http://localhost:8080/api/bpp
BECKN_BAP_ID=skill-verification-bap.onest.network
# When using ngrok for external sandbox: https://your-tunnel.ngrok-free.app/api/beckn
BECKN_BAP_URI=http://localhost:8080/api/beckn
BECKN_KEY_ID=key-1

# Optional Ed25519 Cryptographic Keys (Auto-generated on startup if left empty)
# BECKN_PRIVATE_KEY=
# BECKN_PUBLIC_KEY=

# Security Config (256-bit secret key for JWT)
JWT_SECRET=this-is-a-placeholder-secret-key-that-should-be-changed-in-production-this-is-a-placeholder-secret-key-that-should-be-changed-in-production

# Database Configuration (Defaults to MySQL localhost:3306)
DB_URL=jdbc:mysql://localhost:3306/skill_verification?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
